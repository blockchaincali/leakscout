# Your Orbio key. Claim it on orbio.so or through the Orbio MCP (orbio_claim_key).
# It is an OpenRouter key: one key, every model.
OPENROUTER_API_KEY=
# Optional. Defaults to Orbio's OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://api.orbio.so/api/v1

# Optional legacy default for starter examples outside LeakScout.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional LeakScout role overrides. Defaults are configured in src/lib/modelConfig.ts.
LEAKSCOUT_SCOUT_MODEL=google/gemini-3.8-flash
LEAKSCOUT_INVESTIGATOR_MODEL=anthropic/claude-sonnet-5
LEAKSCOUT_CRITIC_MODEL=openai/gpt-6-astra
LEAKSCOUT_BRIEF_MODEL=openai/gpt-6-astra
LEAKSCOUT_CHAT_MODEL=anthropic/claude-sonnet-5
LEAKSCOUT_PUBLIC_ASSISTANT_MODEL=google/gemini-3.8-flash

# Optional. Shown on OpenRouter's public rankings for your app.
APP_NAME=Orbio Build Week
APP_URL=https://orbio.so/build

# Required by trusted server-to-server integration routes.
LEAKSCOUT_INTEGRATION_SECRET=
