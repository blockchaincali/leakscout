{
  "name": "leakscout",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous business investigation for verified profit and operational leaks.",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/leakscout/web/server.ts",
    "chat": "tsx src/examples/01-chat.ts",
    "tools": "tsx src/examples/02-tools.ts",
    "structured": "tsx src/examples/03-structured.ts",
    "search": "tsx src/examples/04-web-search.ts",
    "image": "tsx src/examples/05-image.ts",
    "pdf": "tsx src/examples/06-pdf.ts",
    "agent": "tsx src/examples/07-agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/leakscout/tests/leakscout.test.ts src/leakscout/tests/assistant.test.ts",
    "lint": "eslint .",
    "leakscout:web": "tsx src/leakscout/web/server.ts",
    "leakscout:audit": "tsx src/leakscout/test-audit.ts",
    "leakscout:agent": "tsx src/leakscout/test-agent.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^5.20.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
